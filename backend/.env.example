# ==============================================================================
# MediSync 360 - Backend Environment Variables Example
# ==============================================================================
# Copy this file to .env:
# cp .env.example .env

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.794qvgm.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=medisync_db
DATABASE_URL=mongodb+srv://<username>:<password>@cluster0.794qvgm.mongodb.net/medisync_db?retryWrites=true&w=majority

# Google Gemini / AI API Key
# Get your key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Authentication
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
