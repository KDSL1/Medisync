# ==============================================================================
# MediSync 360 - Root Environment Variables Example
# ==============================================================================
# Copy this file to .env:
# cp .env.example .env

# Google Gemini API Key for AI Medical Report Explainer
# Get your key from Google AI Studio: https://aistudio.google.com/app/apikey
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# Backend FastAPI Service Base URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# Application Details
NEXT_PUBLIC_APP_NAME="MediSync 360"
NEXT_PUBLIC_APP_ENV=development

# Server Port (Default: 3000)
PORT=3000

# MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.794qvgm.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=medisync_db
